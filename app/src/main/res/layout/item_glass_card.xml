<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="208dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_glass_normal"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivCardIcon"
            android:layout_width="98dp"
            android:layout_height="98dp"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.14"
            android:singleLine="true"
            android:text="MEDIA HUB"
            android:textColor="#F2F8FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCardSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.16"
            android:singleLine="true"
            android:text="SYSTEM ENTER"
            android:textColor="#A4B8C8"
            android:textSize="8sp"
            android:visibility="invisible" />

        <View
            android:id="@+id/vActiveDot"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/dot_cyan"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- Specular 4-Point Chrome Sparkle Glints -->
    <ImageView
        android:id="@+id/ivGlintTop"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:src="@drawable/ic_glint"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/ivGlintBottom"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/ic_glint"
        android:visibility="invisible" />
</FrameLayout>
