<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06080B"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Slightly Oversized Pure Silver Ice Wallpaper for Smooth Parallax -->
    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:scaleX="1.08"
        android:scaleY="1.08"
        android:src="@drawable/bg_silver_ice" />

    <!-- Animated Subtle Silver-Ice Grid + Breathing Spotlight -->
    <com.chrometv.launcher.AmbientHudView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD Bar (Generous 56dp TV Overscan Safe Margins!) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="24dp">

        <!-- Dynamic Top-Left Pill: 04 • MEDIA HUB -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/status_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvTopIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.16"
                android:text="04"
                android:textColor="#EDF5FC"
                android:textSize="13sp" />

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dot_cyan" />

            <TextView
                android:id="@+id/tvTopSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.22"
                android:text="MEDIA HUB"
                android:textColor="#D4E2EE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Top-Right Clock + Frosted Live VPN & WI-FI Capsule -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/textClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:letterSpacing="0.06"
                android:textColor="#F4FAFF"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/status_pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/ivStatusVpn"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_status_vpn" />

                <TextView
                    android:id="@+id/tvStatusVpn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.14"
                    android:text="VPN"
                    android:textColor="#889AAA"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="•"
                    android:textColor="#558096"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/ivStatusWifi"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_status_wifi" />

                <TextView
                    android:id="@+id/tvStatusWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.14"
                    android:text="WI-FI"
                    android:textColor="#889AAA"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Center-Locked 3D CoverFlow Carousel with Generous Vertical Room (Zero Clip!) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCarousel"
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:layout_gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="52dp"
        android:paddingBottom="52dp" />

    <!-- Bottom Minimalist Navigation Hint (Generous Safe Margins) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingBottom="22dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="#28B8CADB" />

        <TextView
            android:id="@+id/tvBottomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.18"
            android:text="◄ ► NAVIGATE      ✕ ENTER      ● HOLD OK: BIND APP"
            android:textColor="#9EB0C0"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Glassmorphic Overlay: All Apps / Bind App Picker -->
    <LinearLayout
        android:id="@+id/appsOverlay"
        android:layout_width="700dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:background="@drawable/drawer_bg"
        android:elevation="28dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.20"
            android:text="ALL APPLICATIONS"
            android:textColor="#EDF6FF"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.16"
            android:text="OK: SELECT    •    BACK: CLOSE"
            android:textColor="#8AA0B4"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
