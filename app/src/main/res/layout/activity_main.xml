<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080D">

    <!-- Dark Liquid-Chrome Wallpaper -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_chrome_dark" />

    <!-- Animated Architectural Grid + Breathing Cyan Spotlight -->
    <com.chrometv.launcher.AmbientHudView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="46dp"
        android:paddingEnd="46dp"
        android:paddingTop="30dp">

        <!-- Dynamic Top-Left Pill: 04 • MEDIA HUB -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/status_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvTopIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.18"
                android:text="04"
                android:textColor="#E8F4FF"
                android:textSize="15sp" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/dot_cyan" />

            <TextView
                android:id="@+id/tvTopSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.24"
                android:text="MEDIA HUB"
                android:textColor="#D0E2F2"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Top-Right Clock + Frosted Capsule with Live VPN & WI-FI -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/textClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:letterSpacing="0.06"
                android:textColor="#F4FAFF"
                android:textSize="36sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/status_pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivStatusVpn"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_status_vpn" />

                <TextView
                    android:id="@+id/tvStatusVpn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.16"
                    android:text="VPN"
                    android:textColor="#889AAA"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="•"
                    android:textColor="#558096"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/ivStatusWifi"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_status_wifi" />

                <TextView
                    android:id="@+id/tvStatusWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.16"
                    android:text="WI-FI"
                    android:textColor="#889AAA"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Center-Locked Horizontal Glass Carousel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCarousel"
        android:layout_width="match_parent"
        android:layout_height="370dp"
        android:layout_gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- Bottom Minimalist Navigation Hint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="14dp"
            android:background="#2EB8CADB" />

        <TextView
            android:id="@+id/tvBottomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.20"
            android:text="◄ ► NAVIGATE      ✕ ENTER      ● HOLD OK: BIND APP"
            android:textColor="#A6BACD"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Glassmorphic Overlay: All Apps / Bind App Picker -->
    <LinearLayout
        android:id="@+id/appsOverlay"
        android:layout_width="780dp"
        android:layout_height="470dp"
        android:layout_gravity="center"
        android:background="@drawable/drawer_bg"
        android:elevation="24dp"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.22"
            android:text="ALL APPLICATIONS"
            android:textColor="#EAF5FF"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.18"
            android:text="OK: SELECT    •    BACK: CLOSE"
            android:textColor="#8AA0B4"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
