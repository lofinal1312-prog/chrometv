<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080D">

    <!-- Dark Liquid-Chrome Wallpaper -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_chrome_dark" />

    <!-- Subtle Vignette for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26060A10" />

    <!-- Top HUD Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="32dp">

        <!-- Dynamic Top-Left Label: 01 • YOUTUBE -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTopIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.18"
                android:text="01"
                android:textColor="#D8E8F4"
                android:textSize="17sp" />

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/dot_cyan" />

            <TextView
                android:id="@+id/tvTopSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.22"
                android:text="YOUTUBE"
                android:textColor="#C2D4E4"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Top-Right Clock + Live Wi-Fi & VPN Icons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/textClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:letterSpacing="0.06"
                android:textColor="#F0F6FC"
                android:textSize="34sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivStatusVpn"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_status_vpn" />

                <TextView
                    android:id="@+id/tvStatusVpn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.14"
                    android:text="VPN"
                    android:textColor="#889AAA"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="•"
                    android:textColor="#558096"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/ivStatusWifi"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_status_wifi" />

                <TextView
                    android:id="@+id/tvStatusWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.14"
                    android:text="WI-FI"
                    android:textColor="#889AAA"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Center Horizontal Glass Carousel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCarousel"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="120dp"
        android:paddingEnd="120dp" />

    <!-- Bottom Minimalist Navigation Hint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingBottom="26dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="14dp"
            android:background="#26B8CADB" />

        <TextView
            android:id="@+id/tvBottomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.18"
            android:text="◄ ► NAVIGATE      ✕ ENTER      ● HOLD OK: BIND APP"
            android:textColor="#9EB2C4"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Glassmorphic Overlay: All Apps / Bind App Picker -->
    <LinearLayout
        android:id="@+id/appsOverlay"
        android:layout_width="760dp"
        android:layout_height="460dp"
        android:layout_gravity="center"
        android:background="@drawable/drawer_bg"
        android:elevation="24dp"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.2"
            android:text="ALL APPLICATIONS"
            android:textColor="#E8F4FF"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.16"
            android:text="OK: SELECT    •    BACK: CLOSE"
            android:textColor="#8AA0B4"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
