<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#7882B6D0" android:endColor="#552B4354" />
            <stroke android:width="1.5dp" android:color="#E8E8F8FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#24FFFFFF" />
            <stroke android:width="1dp" android:color="#28B8CADB" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
