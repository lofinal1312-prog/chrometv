<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#503B4A58"
                android:centerColor="#381A242E"
                android:endColor="#480E141B" />
            <stroke android:width="1.2dp" android:color="#66C2D4E4" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Subtle inner top glass highlight -->
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="110dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="17dp" android:topRightRadius="17dp" />
        </shape>
    </item>
</layer-list>
